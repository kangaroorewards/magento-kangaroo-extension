<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <event name="sales_order_save_after">
        <observer name="sales_order_state_change_before_OrderState" instance="Kangaroorewards\Core\Observer\UpdateOrderObserver" />
    </event>
    <event name="review_save_after">
        <observer name="review_save_after_post_review" instance="Kangaroorewards\Core\Observer\UpdateReviewObserver" />
    </event>
    <event name="sales_order_shipment_save_after">
        <observer name="kangaroo_shipment_created" instance="Kangaroorewards\Core\Observer\ShipmentTrackingObserver" />
    </event>
    <event name="sales_order_shipment_track_save_after">
        <observer name="kangaroo_shipment_tracking_update" instance="Kangaroorewards\Core\Observer\ShipmentTrackingObserver" />
    </event>
    <event name="catalog_product_save_after">
        <observer name="kangaroo_product_state_product_save" instance="Kangaroorewards\Core\Observer\ProductSaveObserver" />
    </event>
    <event name="cataloginventory_stock_item_save_after">
        <observer name="kangaroo_product_state_stock_item_save" instance="Kangaroorewards\Core\Observer\StockItemSaveObserver" />
    </event>
    <event name="catalog_product_attribute_update_before">
        <observer name="kangaroo_product_state_mass_update" instance="Kangaroorewards\Core\Observer\MassAttributeUpdateObserver" />
    </event>
</config>
